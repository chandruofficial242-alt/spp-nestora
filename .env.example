# ==============================================================================
# SPP NESTORA — PRODUCTION ENVIRONMENT CONFIGURATION
# "Find Your Place. Build Your Future."
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Session & Token Security (Must be at least 32 random characters for HMAC SHA-256)
SESSION_SECRET=spp_nestora_super_secure_session_secret_change_in_production_2026

# PostgreSQL Relational Database URL
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Razorpay Production / Sandbox Gateway Keys
# Obtain from Razorpay Dashboard -> Settings -> API Keys
# When RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET are set, real Razorpay orders & webhook signatures are processed.
# In sandbox development without keys, sandbox simulation is used automatically.
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit_real_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_from_razorpay_dashboard

# Cloudinary / Object Storage Credentials
# Used for persistent property images and video uploads without base64 or temporary browser RAM
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Centralized SPP Nestora Official Contact Defaults
# Changing these in the Admin Settings panel updates all Call & WhatsApp buttons across the platform
OFFICIAL_PHONE=9715673055
OFFICIAL_WHATSAPP=919715673055
OFFICIAL_EMAIL=chandru.official242@gmail.com
BUSINESS_NAME="SPP Nestora"
DEFAULT_LISTING_FEE=10

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here

# Client API Base URL
VITE_API_BASE_URL=/api
